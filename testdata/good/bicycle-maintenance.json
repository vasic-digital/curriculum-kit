          "id": "asm-brakes",
          "areaId": "area-brakes",
          "title": "Rim brakes — end of area test",
          "requiredLessons": ["les-brakes-anatomy", "les-brakes-adjust"],
          "passPercent": 70,
          "questions": [
            {
              "id": "q-brake-force",
              "kind": "single",
              "prompt": "Where does a rim brake apply its stopping force?",
              "choices": [
                { "id": "ch-brake-force-a", "text": "Against the braking surface of the rim" },
                { "id": "ch-brake-force-b", "text": "Against the tyre sidewall" },
                { "id": "ch-brake-force-c", "text": "Against the hub shell" }
              ],
              "correctChoices": ["ch-brake-force-a"],
              "points": 2,
              "explanation": "The pads clamp the rim's flat braking surface; the tyre and hub are never contacted.",
              "ord": 1
            },
            {
              "id": "q-brake-replace",
              "kind": "multi",
              "prompt": "Which observations mean a pad must be replaced rather than adjusted?",
              "choices": [
                { "id": "ch-brake-replace-a", "text": "The wear grooves are no longer visible" },
                { "id": "ch-brake-replace-b", "text": "The pad is slightly off-centre" },
                { "id": "ch-brake-replace-c", "text": "Metal is showing through the compound" }
              ],
              "correctChoices": ["ch-brake-replace-a", "ch-brake-replace-c"],
              "points": 3,
              "explanation": "Off-centre is an adjustment; no grooves and exposed metal are both end-of-life.",
              "ord": 2
            }
          ]
        }
